# API key auth remains enabled for exports and higher-volume access.
FPDS_ANALYTICS_REQUIRE_AUTH=1

# Public row queries are enabled for free bounded access.
FPDS_ANALYTICS_PUBLIC_ROWS_ENABLED=1
FPDS_ANALYTICS_PUBLIC_ROW_LIMIT=25

# Prefer SHA-256 hashes of API keys in production.
# Generate with: printf '%s' "$FPDS_API_KEY" | sha256sum
FPDS_ANALYTICS_API_KEY_HASHES=replace_me_sha256_hex

# Plaintext keys are supported for local testing only.
# FPDS_ANALYTICS_API_KEYS=fpds_live_replace_me

# CORS is disabled by default. Set explicit browser origins only if needed.
FPDS_ANALYTICS_ALLOWED_ORIGINS=https://kenosaconsulting.com
# FPDS_ANALYTICS_ALLOW_ALL_ORIGINS=1

# Rate limiting is enabled by default. Use Redis for multi-instance deployments.
FPDS_ANALYTICS_RATE_LIMIT_ENABLED=1
# FPDS_ANALYTICS_REDIS_URL=redis://localhost:6379/0
FPDS_ANALYTICS_API_KEY_RATE_LIMIT_REQUESTS=120
FPDS_ANALYTICS_API_KEY_RATE_LIMIT_WINDOW_SECONDS=60
FPDS_ANALYTICS_PUBLIC_RATE_LIMIT_REQUESTS=300
FPDS_ANALYTICS_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
FPDS_ANALYTICS_UNAUTH_DATA_RATE_LIMIT_REQUESTS=30
FPDS_ANALYTICS_UNAUTH_DATA_RATE_LIMIT_WINDOW_SECONDS=60

# Prefer a DSN that points at the restricted fpds_analytics_api_readonly role.
# The public repository does not include Kenosa database credentials or hosts.
ANALYTICS_DATABASE_URL=postgresql://fpds_analytics_api_readonly:replace_me@db.example.invalid:5432/postgres

# Alternative component-based connection settings used only if no DSN is set.
DB_HOST=db.example.invalid
DB_PORT=5432
DB_NAME=postgres
DB_USER=fpds_analytics_api_readonly
DB_PASS=replace_me

# ── Chat endpoint ───────────────────────────────────────────────────
# LLM provider — used for the server_key (paid) plan. Users on the free plan
# bring their own API key through the frontend.
FPDS_CHAT_LLM_API_KEY=sk-your-deepseek-or-openai-key
FPDS_CHAT_LLM_BASE_URL=https://api.deepseek.com
FPDS_CHAT_LLM_MODEL=deepseek-chat
FPDS_CHAT_MAX_ROUNDS=8
FPDS_CHAT_MAX_RESULT_CHARS=8000

# Set to 1 to enable the /v1/chat/upgrade endpoint (flips plans without Stripe).
# Remove in production — replace with real Stripe integration.
FPDS_CHAT_TEST_MODE=1

# Supabase Auth — required for JWT validation and user plan lookups.
# These are from your Supabase project dashboard: Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi... (public anon key)

# ── Email delivery (API key signup) ─────────────────────────────────
# SMTP relay for sending API keys via email on signup.
# If unset, email sending is silently skipped (dev-friendly).
# Works with Gmail (app password), SendGrid, Mailgun, Resend, etc.
# FPDS_SMTP_HOST=smtp.example.com
# FPDS_SMTP_PORT=587
# FPDS_SMTP_USER=your-smtp-user
# FPDS_SMTP_PASS=your-smtp-password
# FPDS_SMTP_FROM=no-reply@kenosaconsulting.com
# FPDS_SMTP_USE_TLS=1

# ── OAuth persistence (survives restarts) ───────────────────────────
# OAuth tokens are now stored in api_admin.oauth_* tables (see sql/073).
# No additional config needed — uses the same ANALYTICS_DATABASE_URL.
